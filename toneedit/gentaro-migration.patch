index 0000000..864fc34
--- /dev/null
+++ b/src/gentaro.rs
@@ -0,0 +1,397 @@
+//! Native Rust execution bridge for the currently documented subset of ToneGentaro.
+//! The actual editing policy is stored as Japanese `.tone` source, not repeated here.
+//! No JavaScript, HTML or Python is used by this runtime.
+use std::collections::HashMap;
+use std::sync::OnceLock;
+
+const RULES: &str = include_str!("../gentaro/ToneEdit_規則.tone");
+const STARTUP: &str = include_str!("../gentaro/ToneEdit_起動.tone");
+
+#[derive(Clone, Debug, PartialEq)]
+pub enum Value {
+    Text(String),
+    Bool(bool),
+    Integer(i64),
+}
+impl Value {
+    fn boolean(self) -> Result<bool, String> {
+        if let Self::Bool(value) = self { Ok(value) } else { Err("Expected a Gentaro true/false result".into()) }
+    }
+    fn text(self) -> Result<String, String> {
+        if let Self::Text(value) = self { Ok(value) } else { Err("Expected a Gentaro text result".into()) }
+    }
+}
+#[derive(Debug)]
+enum Statement {
+    If { condition: String, yes: Vec<Statement>, no: Vec<Statement> },
+    Return(String),
+    Display(String),
+    Variable(String, String),
+}
+struct Function { params: Vec<String>, body: Vec<Statement> }
+struct Engine { functions: HashMap<String, Function> }
+
+impl Engine {
+    fn parse(source: &str) -> Result<Self, String> {
+        let lines: Vec<&str> = source.lines().map(str::trim)
+            .filter(|line| !line.is_empty() && !line.starts_with('#')).collect();
+        let mut at = 0;
+        let mut functions = HashMap::new();
+        while at < lines.len() {
+            let signature = lines[at].strip_prefix("関数 ")
+                .ok_or_else(|| format!("Expected 関数 declaration at: {}", lines[at]))?
+                .strip_suffix(':').ok_or("Gentaro function needs a colon")?;
+            let (name, raw_params) = signature.split_once('(').ok_or("Function needs parentheses")?;
+            let raw_params = raw_params.strip_suffix(')').ok_or("Unclosed function parameters")?;
+            let params: Vec<String> = if raw_params.trim().is_empty() {
+                Vec::new()
+            } else { raw_params.split(',').map(|p| p.trim().to_owned()).collect() };
+            if name.trim().is_empty() || params.iter().any(|p| p.is_empty()) {
+                return Err("Empty function or parameter name".into());
+            }
+            at += 1;
+            let body = parse_block(&lines, &mut at)?;
+            if lines.get(at) != Some(&"終わり") { return Err(format!("Missing 終わり for {name}")); }
+            at += 1;
+            if functions.insert(name.trim().to_owned(), Function { params, body }).is_some() {
+                return Err(format!("Duplicate Gentaro function: {name}"));
+            }
+        }
+        Ok(Self { functions })
+    }
+    fn call(&self, name: &str, args: &[Value]) -> Result<Value, String> {
+        let function = self.functions.get(name).ok_or_else(|| format!("No Gentaro function: {name}"))?;
+        if args.len() != function.params.len() {
+            return Err(format!("Argument count mismatch for Gentaro function: {name}"));
+        }
+        let mut vars: HashMap<String, Value> = function.params.iter().cloned()
+            .zip(args.iter().cloned()).collect();
+        let mut budget = 1024usize;
+        execute(&function.body, &mut vars, &mut budget)?
+            .ok_or_else(|| format!("No return value from Gentaro function: {name}"))
+    }
+}
+fn parse_block(lines: &[&str], at: &mut usize) -> Result<Vec<Statement>, String> {
+    let mut statements = Vec::new();
+    while let Some(&line) = lines.get(*at) {
+        if line == "終わり" || line == "そうでなければ:" { break; }
+        if let Some(cond) = line.strip_prefix("もし ").and_then(|part| part.strip_suffix(" なら:")) {
+            *at += 1;
+            let yes = parse_block(lines, at)?;
+            let no = if lines.get(*at) == Some(&"そうでなければ:") {
+                *at += 1;
+                parse_block(lines, at)?
+            } else { Vec::new() };
+            if lines.get(*at) != Some(&"終わり") {
+                return Err(format!("Missing 終わり after もし: {cond}"));
+            }
+            *at += 1;
+            statements.push(Statement::If { condition: cond.to_owned(), yes, no });
+            continue;
+        }
+        if let Some(expr) = line.strip_suffix(" を返す") {
+            statements.push(Statement::Return(expr.to_owned()));
+        } else if let Some(expr) = line.strip_suffix(" を表示") {
+            statements.push(Statement::Display(expr.to_owned()));
+        } else if let Some(declaration) = line.strip_prefix("変数 ") {
+            let (name, expression) = declaration.split_once(" = ")
+                .ok_or("Invalid Gentaro variable assignment")?;
+            statements.push(Statement::Variable(name.to_owned(), expression.to_owned()));
+        } else {
+            return Err(format!("Unrecognized Gentaro statement: {line}"));
+        }
+        *at += 1;
+    }
+    Ok(statements)
+}
+fn execute(body: &[Statement], vars: &mut HashMap<String, Value>, budget: &mut usize)
+    -> Result<Option<Value>, String> {
+    for statement in body {
+        if *budget == 0 { return Err("Gentaro execution budget exceeded".into()); }
+        *budget -= 1;
+        match statement {
+            Statement::Return(expr) => return Ok(Some(evaluate(expr, vars)?)),
+            Statement::Display(expr) => {
+                // Display is intentionally NOT printed from embedded UI policies.
+                let _ = evaluate(expr, vars)?;
+            }
+            Statement::Variable(name, expr) => {
+                let value = evaluate(expr, vars)?;
+                vars.insert(name.clone(), value);
+            }
+            Statement::If { condition, yes, no } => {
+                let value = evaluate(condition, vars)?.boolean()?;
+                if let Some(result) = execute(if value { yes } else { no }, vars, budget)? {
+                    return Ok(Some(result));
+                }
+            }
+        }
+    }
+    Ok(None)
+}
+
+#[derive(Clone, Debug, PartialEq)]
+enum Token { Text(String), Identifier(String), Number(i64), Symbol(String), Open, Close }
+fn tokenize(input: &str) -> Result<Vec<Token>, String> {
+    let chars: Vec<char> = input.chars().collect();
+    let mut at = 0;
+    let mut out = Vec::new();
+    while at < chars.len() {
+        let c = chars[at];
+        if c.is_whitespace() { at += 1; continue; }
+        if c == '「' {
+            let start = at + 1;
+            at += 1;
+            while at < chars.len() && chars[at] != '」' { at += 1; }
+            if at == chars.len() { return Err("Unclosed Gentaro text literal".into()); }
+            out.push(Token::Text(chars[start..at].iter().collect()));
+            at += 1;
+        } else if c.is_ascii_digit() {
+            let start = at;
+            while at < chars.len() && chars[at].is_ascii_digit() { at += 1; }
+            let number: String = chars[start..at].iter().collect();
+            out.push(Token::Number(number.parse().map_err(|_| "Integer overflow")?));
+        } else if c == '(' { out.push(Token::Open); at += 1; }
+        else if c == ')' { out.push(Token::Close); at += 1; }
+        else if "=!<>+-*/%&|".contains(c) {
+            let mut op = c.to_string();
+            at += 1;
+            if at < chars.len() && (chars[at] == '=' || chars[at] == c && (c == '&' || c == '|')) {
+                op.push(chars[at]); at += 1;
+            }
+            if !["==", "!=", ">=", "<=", ">", "<", "+", "-", "*", "/", "%", "!", "&&", "||"].contains(&op.as_str()) {
+                return Err(format!("Unsupported Gentaro operator: {op}"));
+            }
+            out.push(Token::Symbol(op));
+        } else {
+            let start = at;
+            while at < chars.len() && !chars[at].is_whitespace()
+                && !"「」()=!<>+-*/%&|".contains(chars[at]) { at += 1; }
+            if start == at { return Err(format!("Unrecognized Gentaro character: {}", chars[at])); }
+            let name: String = chars[start..at].iter().collect();
+            if name == "かつ" { out.push(Token::Symbol("&&".into())); }
+            else if name == "または" { out.push(Token::Symbol("||".into())); }
+            else { out.push(Token::Identifier(name)); }
+        }
+    }
+    Ok(out)
+}
+struct Expression<'a> { tokens: Vec<Token>, at: usize, vars: &'a HashMap<String, Value> }
+impl<'a> Expression<'a> {
+    fn eat(&mut self, op: &str) -> bool {
+        if let Some(Token::Symbol(current)) = self.tokens.get(self.at) {
+            if current == op { self.at += 1; return true; }
+        }
+        false
+    }
+    fn logical_or(&mut self) -> Result<Value, String> {
+        let mut left = self.logical_and()?;
+        while self.eat("||") {
+            let right = self.logical_and()?;
+            left = Value::Bool(left.boolean()? || right.boolean()?);
+        }
+        Ok(left)
+    }
+    fn logical_and(&mut self) -> Result<Value, String> {
+        let mut left = self.compare()?;
+        while self.eat("&&") {
+            let right = self.compare()?;
+            left = Value::Bool(left.boolean()? && right.boolean()?);
+        }
+        Ok(left)
+    }
+    fn compare(&mut self) -> Result<Value, String> {
+        let mut left = self.add()?;
+        loop {
+            let operator = if self.eat("==") { "==" } else if self.eat("!=") { "!=" }
+                else if self.eat(">=") { ">=" } else if self.eat("<=") { "<=" }
+                else if self.eat(">") { ">" } else if self.eat("<") { "<" }
+                else { break; };
+            let right = self.add()?;
+            let result = match operator {
+                "==" => left == right,
+                "!=" => left != right,
+                _ => match (&left, &right) {
+                    (Value::Integer(a), Value::Integer(b)) => match operator {
+                        ">=" => a >= b, "<=" => a <= b, ">" => a > b, "<" => a < b, _ => unreachable!(),
+                    },
+                    _ => return Err("Comparison requires two integers".into()),
+                },
+            };
+            left = Value::Bool(result);
+        }
+        Ok(left)
+    }
+    fn add(&mut self) -> Result<Value, String> {
+        let mut left = self.multiply()?;
+        loop {
+            let operator = if self.eat("+") { "+" } else if self.eat("-") { "-" } else { break };
+            let right = self.multiply()?;
+            left = match (left, right, operator) {
+                (Value::Text(a), Value::Text(b), "+") => Value::Text(a + &b),
+                (Value::Integer(a), Value::Integer(b), "+") => Value::Integer(a.checked_add(b).ok_or("Integer overflow")?),
+                (Value::Integer(a), Value::Integer(b), "-") => Value::Integer(a.checked_sub(b).ok_or("Integer overflow")?),
+                _ => return Err("Incompatible Gentaro arithmetic operands".into()),
+            };
+        }
+        Ok(left)
+    }
+    fn multiply(&mut self) -> Result<Value, String> {
+        let mut left = self.atom()?;
+        loop {
+            let operator = if self.eat("*") { "*" } else if self.eat("/") { "/" }
+                else if self.eat("%") { "%" } else { break; };
+            let right = self.atom()?;
+            left = match (left, right) {
+                (Value::Integer(a), Value::Integer(b)) => Value::Integer(match operator {
+                    "*" => a.checked_mul(b), "/" => a.checked_div(b), "%" => a.checked_rem(b), _ => None,
+                }.ok_or("Gentaro arithmetic overflow or division by zero")?),
+                _ => return Err("Multiplication requires integers".into()),
+            };
+        }
+        Ok(left)
+    }
+    fn atom(&mut self) -> Result<Value, String> {
+        if self.eat("!") { return Ok(Value::Bool(!self.atom()?.boolean()?)); }
+        if self.eat("-") {
+            if let Value::Integer(value) = self.atom()? {
+                return Ok(Value::Integer(value.checked_neg().ok_or("Integer overflow")?));
+            }
+            return Err("Unary minus requires an integer".into());
+        }
+        let token = self.tokens.get(self.at).cloned().ok_or("Missing Gentaro expression")?;
+        self.at += 1;
+        match token {
+            Token::Text(s) => Ok(Value::Text(s)),
+            Token::Number(n) => Ok(Value::Integer(n)),
+            Token::Identifier(name) if name == "真" => Ok(Value::Bool(true)),
+            Token::Identifier(name) if name == "偽" => Ok(Value::Bool(false)),
+            Token::Identifier(name) => self.vars.get(&name).cloned().ok_or_else(|| format!("Unknown Gentaro variable: {name}")),
+            Token::Open => {
+                let value = self.logical_or()?;
+                if self.tokens.get(self.at) != Some(&Token::Close) { return Err("Missing closing parenthesis".into()); }
+                self.at += 1;
+                Ok(value)
+            }
+            _ => Err("Unsupported Gentaro expression".into()),
+        }
+    }
+}
+fn evaluate(expr: &str, vars: &HashMap<String, Value>) -> Result<Value, String> {
+    let mut parser = Expression { tokens: tokenize(expr)?, at: 0, vars };
+    let result = parser.logical_or()?;
+    if parser.at != parser.tokens.len() { return Err(format!("Trailing expression tokens in {expr}")); }
+    Ok(result)
+}
+
+static ENGINE: OnceLock<Result<Engine, String>> = OnceLock::new();
+fn invoke(name: &str, args: &[Value]) -> Result<Value, String> {
+    let engine = ENGINE.get_or_init(|| {
+        let mut engine = Engine::parse(RULES)?;
+        let startup = Engine::parse(STARTUP)?;
+        for (name, function) in startup.functions {
+            if engine.functions.insert(name.clone(), function).is_some() {
+                return Err(format!("Duplicate name across Gentaro components: {name}"));
+            }
+        }
+        Ok(engine)
+    }).as_ref().map_err(|error| error.clone())?;
+    engine.call(name, args)
+}
+fn boolean(v: bool) -> Value { Value::Bool(v) }
+
+pub fn product_name() -> Result<String, String> {
+    invoke("製品名", &[])?.text()
+}
+
+pub fn document_title(name: &str, modified: bool) -> Result<String, String> {
+    invoke("文書名を作る", &[Value::Text(name.to_owned()), boolean(modified)])?.text()
+}
+pub fn block_unsafe_save(file_exists: bool, timestamp_equal: bool, content_equal: bool) -> Result<bool, String> {
+    invoke("保存を拒否する", &[boolean(file_exists), boolean(timestamp_equal), boolean(content_equal)])?.boolean()
+}
+pub fn skip_search(query: &str) -> Result<bool, String> {
+    invoke("検索を省略する", &[Value::Text(query.to_owned())])?.boolean()
+}
+pub fn split_conversation(has_history: bool, vendor_changed: bool, endpoint_changed: bool) -> Result<bool, String> {
+    invoke("会話を分離する", &[boolean(has_history), boolean(vendor_changed), boolean(endpoint_changed)])?.boolean()
+}
+pub fn api_key_required(vendor_id: &str) -> Result<bool, String> {
+    invoke("AI鍵が必要", &[Value::Text(vendor_id.to_owned())])?.boolean()
+}
+pub fn provider_protocol(vendor_id: &str) -> Result<String, String> {
+    invoke("API形式を選ぶ", &[Value::Text(vendor_id.to_owned())])?.text()
+}
+pub fn reject_ai_send(in_flight: bool, empty: bool, too_large: bool) -> Result<bool, String> {
+    invoke("送信を拒否する", &[boolean(in_flight), boolean(empty), boolean(too_large)])?.boolean()
+}
+pub fn save_status(modified: bool) -> Result<String, String> {
+    invoke("入力済みの表示", &[boolean(modified)])?.text()
+}
+pub fn installer_path_denied(not_absolute: bool, has_parent: bool, unsafe_depth: bool) -> Result<bool, String> {
+    invoke("インストール先を拒否する", &[boolean(not_absolute), boolean(has_parent), boolean(unsafe_depth)])?.boolean()
+}
+pub fn uninstallation_allowed(marker_valid: bool, destination_valid: bool) -> Result<bool, String> {
+    invoke("削除を許可する", &[boolean(marker_valid), boolean(destination_valid)])?.boolean()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test] fn parses_japanese_functions() { assert!(Engine::parse(RULES).is_ok()); }
+    #[test] fn document_names() {
+        assert_eq!(document_title("あ.txt", true).unwrap(), "あ.txt ●");
+        assert_eq!(document_title("a.txt", false).unwrap(), "a.txt");
+    }
+    #[test] fn identity_and_license() {
+        assert_eq!(product_name().unwrap(), "ToneEdit Studio");
+        assert_eq!(invoke("ライセンス", &[]).unwrap(), Value::Text("MIT".into()));
+        assert_eq!(invoke("課金方式", &[]).unwrap(), Value::Text("完全無料".into()));
+    }
+    #[test] fn preserve_external_edits() {
+        assert_eq!(block_unsafe_save(true, true, true).unwrap(), false);
+        assert_eq!(block_unsafe_save(false, true, true).unwrap(), true);
+        assert_eq!(block_unsafe_save(true, false, true).unwrap(), true);
+        assert_eq!(block_unsafe_save(true, true, false).unwrap(), true);
+    }
+    #[test] fn search_and_credential_rules() {
+        assert!(skip_search("").unwrap());
+        assert!(!skip_search("日本語").unwrap());
+        assert!(!api_key_required("ollama").unwrap());
+        assert!(api_key_required("openai").unwrap());
+    }
+    #[test] fn cross_vendor_chat_is_isolated() {
+        assert!(split_conversation(true, true, false).unwrap());
+        assert!(split_conversation(true, false, true).unwrap());
+        assert!(!split_conversation(false, true, true).unwrap());
+    }
+    #[test] fn routes_ai_protocols() {
+        assert_eq!(provider_protocol("anthropic").unwrap(), "anthropic");
+        assert_eq!(provider_protocol("gemini").unwrap(), "gemini");
+        assert_eq!(provider_protocol("openai").unwrap(), "openai互換");
+        assert_eq!(provider_protocol("deepseek").unwrap(), "openai互換");
+    }
+    #[test] fn sends_are_explicit_and_safe() {
+        assert!(reject_ai_send(true, false, false).unwrap());
+        assert!(reject_ai_send(false, true, false).unwrap());
+        assert!(reject_ai_send(false, false, true).unwrap());
+        assert!(!reject_ai_send(false, false, false).unwrap());
+        assert_eq!(save_status(true).unwrap(), "未保存");
+    }
+    #[test] fn deletion_requires_two_validations() {
+        assert!(!uninstallation_allowed(false, true).unwrap());
+        assert!(!uninstallation_allowed(true, false).unwrap());
+        assert!(uninstallation_allowed(true, true).unwrap());
+    }
+    #[test] fn deny_risky_install_directory() {
+        assert!(installer_path_denied(true, false, false).unwrap());
+        assert!(installer_path_denied(false, true, false).unwrap());
+        assert!(!installer_path_denied(false, false, false).unwrap());
+    }
+    #[test] fn expression_operators() {
+        let vars = HashMap::new();
+        assert_eq!(evaluate("(3 + 2) * 4 == 20", &vars).unwrap(), boolean(true));
+        assert_eq!(evaluate("真 かつ 偽", &vars).unwrap(), boolean(false));
+        assert_eq!(evaluate("「日本」 + 「語」", &vars).unwrap(), Value::Text("日本語".into()));
+    }
+}
