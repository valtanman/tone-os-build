+fn smoke_test() -> Result<(), String> {
+    let scratch = std::env::temp_dir().join(format!("toneedit-self-test-{}", std::process::id()));
+    fs::create_dir_all(&scratch).map_err(|e| e.to_string())?;
+    let file = scratch.join("multilingual.txt");
+    let result = (|| {
+        document::save(&file, "日本語\nRust 🌸", Encoding::Utf8Bom, LineEnding::CrLf)?;
+        let loaded = document::load(&file)?;
+        if loaded.text != "日本語\nRust 🌸" || loaded.encoding != Encoding::Utf8Bom
+            || loaded.newline != LineEnding::CrLf {
+            return Err("UTF-8 BOM / CRLF round trip failed".to_owned());
+        }
+        let hits = search::find(&loaded.text, "Rust", false, true, 16)?;
+        if hits.locations.len() != 1 { return Err("Search self-test failed".to_owned()); }
+        document::save(&file, "更新", Encoding::Utf16Le, LineEnding::Lf)?;
+        let backup = fs::read(document::backup_path(&file)).map_err(|e| e.to_string())?;
+        if document::decode_bytes(&backup)?.text != "日本語\nRust 🌸" {
+            return Err("Backup self-test failed".into());
+        }
+        Ok(())
+    })();
+    let _ = fs::remove_dir_all(scratch);
+    result
+}
