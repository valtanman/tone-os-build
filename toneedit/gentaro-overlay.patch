+fn credential_entry(vendor: Vendor) -> Result<keyring::Entry, String> {
+    keyring::Entry::new(SERVICE, &format!("provider.{}.api_key", vendor.id())).map_err(|e| e.to_string())
+}
+
+fn validate_endpoint(vendor: Vendor, endpoint: &str) -> Result<(), String> {
+    let parsed = reqwest::Url::parse(endpoint).map_err(|_| "Invalid API endpoint URL".to_string())?;
+    if vendor == Vendor::Ollama {
+        let host = parsed.host_str().unwrap_or("");
+        if !((host == "localhost" || host == "127.0.0.1" || host == "[::1]")
+            && parsed.scheme() == "http") {
+            return Err("Local Ollama must use an HTTP loopback address".into());
+        }
+    } else if parsed.scheme() != "https" {
+        return Err("API keys are only sent over HTTPS".into());
+    }
+    if !parsed.username().is_empty() || parsed.password().is_some() {
+        return Err("Do not put credentials in the endpoint URL".into());
+    }
+    Ok(())
+}
+fn make_request(vendor: Vendor, model: &str, system: &str, msgs: &[Message]) -> Value {
+    providers::adapter(vendor).format_request(model, system, msgs)
+}
+fn parse_answer(vendor: Vendor, response: &Value) -> Result<String, String> {
+    let content = providers::adapter(vendor).extract_text(response)
+        .filter(|s| !s.trim().is_empty())
+        .ok_or_else(|| "The provider returned no text reply. Check model/provider compatibility.".to_owned())?;
+    if content.len() > MAX_REPLY_BYTES { return Err("Reply too large; rejected for safe storage".into()); }
+    Ok(content)
+}
+fn request_chat(vendor: Vendor, endpoint: &str, model: &str, key: &str,
+                system: &str, messages: &[Message]) -> Result<String, String> {
+    validate_endpoint(vendor, endpoint)?;
+    if messages.iter().any(|m| m.content.len() > MAX_MESSAGE_BYTES) {
+        return Err("A message is larger than 64 KiB".into());
+    }
+    if messages.len() > 100 { return Err("Conversation exceeds 100 messages. Start a new chat.".into()); }
+    let client = reqwest::blocking::Client::builder().connect_timeout(Duration::from_secs(10))
+        .timeout(Duration::from_secs(120)).redirect(reqwest::redirect::Policy::none())
+        .build().map_err(|e| format!("HTTP client unavailable: {e}"))?;
+    let adapter = providers::adapter(vendor);
+    let url = adapter.endpoint(endpoint, model)?;
+    let body = make_request(vendor, model, system, messages);
+    let req = adapter.authorize(client.post(&url).json(&body), key);
+    let response = req.send().map_err(|e| format!("AI request failed: {e}"))?;
+    let status = response.status();
+    if !status.is_success() {
+        // Never reflect a vendor error body into the UI: it may contain token or prompt data.
+        return Err(format!("AI provider returned HTTP {}. Check model, API key, billing and provider status.", status.as_u16()));
+    }
+    // Bound the read itself to avoid allocating an unbounded malicious server response.
+    let mut text = String::new();
+    response.take((MAX_REPLY_BYTES * 3 + 1) as u64).read_to_string(&mut text)
+        .map_err(|e| format!("Could not read AI reply as UTF-8: {e}"))?;
+    if text.len() > MAX_REPLY_BYTES * 3 { return Err("AI reply exceeds response size limit".into()); }
+    let parsed: Value = serde_json::from_str(&text).map_err(|_| "AI response is not valid JSON".to_owned())?;
+    parse_answer(vendor, &parsed)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test] fn credentials_not_serialized() {
+        let json = serde_json::to_string(&ChatFile::default()).unwrap();
+        assert!(!json.contains("api_key"));
+        assert!(!json.contains("password"));
+        assert!(!json.contains("access_token"));
+    }
+    #[test] fn deny_insecure_endpoints() {
+        assert!(validate_endpoint(Vendor::Custom, "http://my-vendor.test/v1/chat/completions").is_err());
+        assert!(validate_endpoint(Vendor::Custom, "https://my-vendor.test/v1/chat/completions").is_ok());
+        assert!(validate_endpoint(Vendor::Ollama, "http://localhost:11434/v1/chat/completions").is_ok());
+    }
+    #[test] fn vendor_payloads() {
+        let msgs = vec![Message { role:"user".into(), content:"Hello".into() }];
+        assert_eq!(make_request(Vendor::Anthropic,"model","",&msgs)["messages"][0]["role"], "user");
+        assert_eq!(make_request(Vendor::Gemini,"model","",&msgs)["contents"][0]["role"], "user");
+        assert_eq!(make_request(Vendor::OpenAi,"model","",&msgs)["messages"][0]["role"], "user");
+    }
+    #[test] fn parse_three_families() {
+        assert_eq!(parse_answer(Vendor::OpenAi, &json!({"choices":[{"message":{"content":"a"}}]})).unwrap(),"a");
+        assert_eq!(parse_answer(Vendor::Anthropic, &json!({"content":[{"text":"b"}]})).unwrap(),"b");
+        assert_eq!(parse_answer(Vendor::Gemini, &json!({"candidates":[{"content":{"parts":[{"text":"c"}]}}]})).unwrap(),"c");
+    }
+    #[test]
+    fn old_chat_history_without_endpoint_remains_readable() {
+        let previous = r#"{"id":42,"title":"Previous chat","provider":"Custom","model":"test","messages":[{"role":"user","content":"hi"}]}"#;
+        let chat: Conversation = serde_json::from_str(previous).unwrap();
+        assert_eq!(chat.provider, Vendor::Custom);
+        assert_eq!(chat.endpoint, None);
+        assert_eq!(chat.messages.len(), 1);
+    }
+    #[test]
+    fn local_and_remote_endpoints_are_separated() {
+        assert!(validate_endpoint(Vendor::Custom, "https://host.invalid/api/chat").is_ok());
+        assert!(validate_endpoint(Vendor::Custom, "http://127.0.0.1:11434/api/chat").is_err());
+        assert!(validate_endpoint(Vendor::Ollama, "http://localhost:11434/api/chat").is_ok());
+        assert!(validate_endpoint(Vendor::Ollama, "http://192.168.0.1:11434/api/chat").is_err());
+        assert!(validate_endpoint(Vendor::Custom, "https://secret:password@host.invalid/api/chat").is_err());
+    }
+}
diff --git a/src/ai/providers/mod.rs b/src/ai/providers/mod.rs
new file mode 100644
index 0000000..9f8cb1f
--- /dev/null
+++ b/src/ai/providers/mod.rs
@@ -0,0 +1,48 @@
+//! Vendor adapter components. Each API family implements the same Rust trait.
+//! Adding a new family does not require changing the conversation UI.
+mod openai_compatible;
+mod anthropic;
+mod gemini;
+
+use super::{Message, Vendor};
+use reqwest::blocking::RequestBuilder;
+use serde_json::Value;
+
+/// Object-safe component interface for outgoing API requests and text replies.
+pub trait AiProviderAdapter: Send + Sync {
+    fn format_request(&self, model: &str, system: &str, messages: &[Message]) -> Value;
+    fn extract_text(&self, response: &Value) -> Option<String>;
+    fn endpoint(&self, endpoint: &str, _model: &str) -> Result<String, String> {
+        Ok(endpoint.to_owned())
+    }
+    fn authorize(&self, request: RequestBuilder, api_key: &str) -> RequestBuilder;
+}
+
+static OPENAI: openai_compatible::OpenAiCompatible = openai_compatible::OpenAiCompatible;
+static ANTHROPIC: anthropic::Anthropic = anthropic::Anthropic;
+static GEMINI: gemini::Gemini = gemini::Gemini;
+
+pub fn adapter(vendor: Vendor) -> &'static dyn AiProviderAdapter {
+    // APIのプロトコル選択は言太郎ソースで定義する。異常時には元の安全な分類へ戻す。
+    match crate::gentaro::provider_protocol(vendor.id()) {
+        Ok(protocol) if protocol == "anthropic" => &ANTHROPIC,
+        Ok(protocol) if protocol == "gemini" => &GEMINI,
+        Ok(_) | Err(_) => match vendor {
+            Vendor::Anthropic => &ANTHROPIC,
+            Vendor::Gemini => &GEMINI,
+            _ => &OPENAI,
+        },
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn adapter_families_return_expected_payloads() {
+        let msgs = vec![Message { role:"user".to_owned(), content:"Hello".to_owned() }];
+        assert_eq!(adapter(Vendor::OpenAi).format_request("model","",&msgs)["messages"][0]["role"], "user");
+        assert_eq!(adapter(Vendor::Anthropic).format_request("model","",&msgs)["messages"][0]["role"], "user");
+        assert_eq!(adapter(Vendor::Gemini).format_request("model","",&msgs)["contents"][0]["role"], "user");
+    }
+}
