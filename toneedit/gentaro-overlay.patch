+}
+
+/// The contents hash supplements modification times: network drives and file
+/// systems with coarse timestamps can report the same time after a rewrite.
+fn fingerprint(path: &Path) -> Result<[u8; 32], String> {
+    let mut file = File::open(path).map_err(|e| format!("Cannot inspect file contents: {e}"))?;
+    let mut digest = Sha256::new();
+    let mut block = [0u8; 8192];
+    loop {
+        let n = file.read(&mut block).map_err(|e| format!("Cannot inspect file contents: {e}"))?;
+        if n == 0 { break; }
+        digest.update(&block[..n]);
+    }
+    Ok(digest.finalize().into())
+}
+impl Document {
+    fn empty(id: u64) -> Self {
+        Self { id, path: None, text: String::new(), dirty: false,
+            encoding: Encoding::Utf8, newline: LineEnding::Lf,
+            disk_modified: None, disk_fingerprint: None, mixed_endings: false }
+    }
+    fn title(&self) -> String {
+        self.path.as_ref().and_then(|p| p.file_name()).map(|s| s.to_string_lossy().into_owned())
+            .unwrap_or_else(|| format!("Untitled-{}", self.id))
+    }
+    fn display_title(&self) -> String {
+        let title = self.title();
+        gentaro::document_title(&title, self.dirty)
+            .unwrap_or_else(|_| format!("{title}{}", if self.dirty { " ●" } else { "" }))
+    }
+    fn from_file(id: u64, path: PathBuf) -> Result<Self, String> {
+        let result = document::load(&path)?;
+        let disk_fingerprint = Some(fingerprint(&path)?);
+        Ok(Self { id, disk_modified: document::file_modification(&path), disk_fingerprint,
+            path: Some(path),
+            text: result.text, dirty: false, encoding: result.encoding, newline: result.newline,
+            mixed_endings: result.mixed_newlines })
+    }
+    fn save(&mut self, path: &Path, force_overwrite: bool) -> Result<(), String> {
+        if !force_overwrite && self.path.as_deref() == Some(path) {
+            // 保存可否の分岐は言太郎ソースを優先して評価する。
+            // 原本保護のため、Rustの安全確認も必ず残す（二重防御）。
+            let file_exists = path.is_file();
+            let time_matches = file_exists && self.disk_modified == document::file_modification(path);
+            let content_matches = if file_exists && time_matches {
+                match self.disk_fingerprint {
+                    Some(known) => fingerprint(path)? == known,
+                    None => true,
+                }
+            } else { false };
+            let blocked_by_gentaro = gentaro::block_unsafe_save(file_exists, time_matches, content_matches)
+                .unwrap_or(true);
+            // A file deleted between opening and saving is also an external change.
+            // Do not silently resurrect it. The explicit force command can override.
+            if !file_exists {
+                return Err("The original file was removed or replaced. Use Save As to avoid data loss.".into());
+            }
+            if !time_matches {
+                return Err("The file was changed or removed by another program. Use Save As to preserve both versions or explicitly overwrite the changed file.".into());
+            }
+            if !content_matches {
+                return Err("The contents of this file changed outside ToneEdit Studio, even though its timestamp did not. Save As or explicitly overwrite it.".into());
+            }
+            if blocked_by_gentaro {
+                return Err("Gentaro policy rejected an unsafe save".into());
+            }
+        }
+        document::save(path, &self.text, self.encoding, self.newline)?;
+        self.path = Some(path.to_owned());
+        self.disk_modified = document::file_modification(path);
+        self.disk_fingerprint = Some(fingerprint(path)?);
+        self.dirty = false;
+        self.mixed_endings = false;
+        Ok(())
+    }
+}
