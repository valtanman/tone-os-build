+//! Vendor-neutral, text-only AI chat. No bundled identity, system persona, passwords or API keys.
+//! API keys/tokens reside in the operating system credential vault via `keyring`.
+use eframe::egui::{self, Color32, RichText};
+use serde::{Deserialize, Serialize};
+use serde_json::{json, Value};
+use std::path::PathBuf;
+use std::io::Read;
+use std::sync::mpsc::{self, Receiver, Sender};
+use std::thread;
+use std::time::Duration;
+
+use crate::google_oauth::{self, GoogleLoginResult};
+mod providers;
+
+const SERVICE: &str = "ToneEdit Studio";
+const MAX_MESSAGE_BYTES: usize = 64 * 1024;
+const MAX_REPLY_BYTES: usize = 2 * 1024 * 1024;
+
+#[derive(Clone, Copy, PartialEq, Eq, Debug, Serialize, Deserialize)]
+pub enum Vendor {
+    OpenAi, Anthropic, Gemini, XAi, DeepSeek, Mistral, Groq, OpenRouter,
+    Together, Perplexity, Ollama, Custom,
+}
+impl Vendor {
+    pub const ALL: [Self; 12] = [Self::OpenAi, Self::Anthropic, Self::Gemini, Self::XAi,
+        Self::DeepSeek, Self::Mistral, Self::Groq, Self::OpenRouter,
+        Self::Together, Self::Perplexity, Self::Ollama, Self::Custom];
+    pub fn label(self) -> &'static str {
+        match self { Self::OpenAi => "OpenAI", Self::Anthropic => "Anthropic Claude",
+            Self::Gemini => "Google Gemini", Self::XAi => "xAI Grok",
+            Self::DeepSeek => "DeepSeek", Self::Mistral => "Mistral",
+            Self::Groq => "Groq", Self::OpenRouter => "OpenRouter",
+            Self::Together => "Together AI", Self::Perplexity => "Perplexity",
+            Self::Ollama => "Ollama (local)", Self::Custom => "Custom OpenAI-compatible" }
+    }
+    pub fn id(self) -> &'static str {
+        match self { Self::OpenAi => "openai", Self::Anthropic => "anthropic",
+            Self::Gemini => "gemini", Self::XAi => "xai", Self::DeepSeek => "deepseek",
+            Self::Mistral => "mistral", Self::Groq => "groq", Self::OpenRouter => "openrouter",
+            Self::Together => "together", Self::Perplexity => "perplexity",
+            Self::Ollama => "ollama", Self::Custom => "custom" }
+    }
+    pub fn default_model(self) -> &'static str {
+        match self { Self::OpenAi => "gpt-4.1-mini", Self::Anthropic => "claude-sonnet-4-5",
+            Self::Gemini => "gemini-2.5-flash", Self::XAi => "grok-3-mini",
+            Self::DeepSeek => "deepseek-chat", Self::Mistral => "mistral-small-latest",
+            Self::Groq => "llama-3.3-70b-versatile", Self::OpenRouter => "openai/gpt-4.1-mini",
+            Self::Together => "meta-llama/Llama-3.3-70B-Instruct-Turbo",
+            Self::Perplexity => "sonar", Self::Ollama => "llama3.2", Self::Custom => "my-model" }
+    }
+    pub fn default_endpoint(self) -> &'static str {
+        match self {
+            Self::OpenAi => "https://api.openai.com/v1/chat/completions",
+            Self::Anthropic => "https://api.anthropic.com/v1/messages",
+            Self::Gemini => "https://generativelanguage.googleapis.com/v1beta",
+            Self::XAi => "https://api.x.ai/v1/chat/completions",
+            Self::DeepSeek => "https://api.deepseek.com/chat/completions",
+            Self::Mistral => "https://api.mistral.ai/v1/chat/completions",
+            Self::Groq => "https://api.groq.com/openai/v1/chat/completions",
+            Self::OpenRouter => "https://openrouter.ai/api/v1/chat/completions",
+            Self::Together => "https://api.together.xyz/v1/chat/completions",
+            Self::Perplexity => "https://api.perplexity.ai/chat/completions",
+            Self::Ollama => "http://127.0.0.1:11434/v1/chat/completions",
+            Self::Custom => "https://example.invalid/v1/chat/completions",
+        }
+    }
+    pub fn requires_key(self) -> bool {
+        crate::gentaro::api_key_required(self.id()).unwrap_or(!matches!(self, Self::Ollama))
+    }
+}
