+#[derive(Clone, Debug, Serialize, Deserialize)]
+pub struct Message { pub role: String, pub content: String }
+#[derive(Clone, Debug, Serialize, Deserialize)]
+pub struct Conversation {
+    id: u64,
+    title: String,
+    provider: Vendor,
+    model: String,
+    #[serde(default)]
+    endpoint: Option<String>,
+    messages: Vec<Message>,
+}
+#[derive(Serialize, Deserialize)]
+#[serde(default)]
+struct ChatFile {
+    vendor: Vendor,
+    model: String,
+    custom_url: String,
+    google_oauth_client_id: String,
+    system_instructions: String,
+    conversations: Vec<Conversation>,
+    current: u64,
+    next_id: u64,
+    // Account identifiers, passwords, access tokens and API keys are deliberately absent.
+}
+impl Default for ChatFile {
+    fn default() -> Self { Self {
+        vendor: Vendor::OpenAi, model: Vendor::OpenAi.default_model().into(),
+        custom_url: Vendor::Custom.default_endpoint().into(), google_oauth_client_id: String::new(),
+        system_instructions: String::new(), conversations: vec![], current: 0, next_id: 1,
+    } }
+}
+struct Reply { id: u64, text: Result<String, String> }
+
+pub struct AiWorkspace {
+    pub visible: bool,
+    pub settings_open: bool,
+    data: ChatFile,
+    path: PathBuf,
+    prompt: String,
+    api_key_input: String,
+    google_client_secret_input: String,
+    status: String,
+    pending: Option<u64>,
+    tx: Sender<Reply>,
+    rx: Receiver<Reply>,
+    google_tx: Sender<GoogleLoginResult>,
+    google_rx: Receiver<GoogleLoginResult>,
+    google_status: String,
+    delete_confirm: Option<u64>,
+}
+
+impl AiWorkspace {
+    pub fn new() -> Self {
+        let mut path = super::default_state_path();
+        path.set_file_name("ai_chat.json");
+        let data = std::fs::read_to_string(&path).ok()
+            .and_then(|s| serde_json::from_str::<ChatFile>(&s).ok()).unwrap_or_default();
+        let (tx, rx) = mpsc::channel();
+        let (google_tx, google_rx) = mpsc::channel();
+        Self { visible: false, settings_open: false, data, path,
+            prompt: String::new(), api_key_input: String::new(),
+            google_client_secret_input: String::new(), status: String::new(),
+            pending: None, tx, rx, google_tx, google_rx,
+            google_status: "Google account is not signed in for this session".into(),
+            delete_confirm: None }
+    }
+    fn save(&mut self) {
+        if let Ok(content) = serde_json::to_string_pretty(&self.data) {
+            if let Err(e) = super::document::save_state(&self.path, &content) {
+                self.status = format!("Chat history save failed: {e}");
+            }
+        }
+    }
+    fn create_chat(&mut self) {
+        let id = self.data.next_id;
+        self.data.next_id += 1;
+        self.data.conversations.push(Conversation { id, title: "New conversation".into(),
+            provider: self.data.vendor, model: self.data.model.clone(),
+            endpoint: None, messages: vec![] });
+        self.data.current = id;
+        self.save();
+    }
+    fn active_chat(&self) -> Option<&Conversation> {
+        self.data.conversations.iter().find(|c| c.id == self.data.current)
+    }
+    fn active_chat_mut(&mut self) -> Option<&mut Conversation> {
+        self.data.conversations.iter_mut().find(|c| c.id == self.data.current)
+    }
+    fn provider_secret(&self) -> Result<String, String> {
+        if !self.data.vendor.requires_key() { return Ok(String::new()); }
+        credential_entry(self.data.vendor).and_then(|e| e.get_password().map_err(|e| format!("Credential not available: {e}")))
+    }
+    fn send(&mut self) {
+        let in_flight = self.pending.is_some();
+        let empty = self.prompt.trim().is_empty();
+        let too_large = self.prompt.len() > MAX_MESSAGE_BYTES;
+        if crate::gentaro::reject_ai_send(in_flight, empty, too_large)
+            .unwrap_or(in_flight || empty || too_large) {
+            if !in_flight && !empty && too_large { self.status = "Prompt exceeds 64 KiB limit".into(); }
+            return;
+        }
+        let key = match self.provider_secret() {
+            Ok(k) => k,
+            Err(e) => { self.status = format!("Set an API key in AI > Connections. {e}"); self.settings_open = true; return; }
+        };
+        let vendor = self.data.vendor;
+        let model = self.data.model.trim().to_string();
+        if model.is_empty() { self.status = "Set a model name in Connections".into(); return; }
+        let endpoint = if vendor == Vendor::Custom { self.data.custom_url.trim().to_owned() }
+                       else { vendor.default_endpoint().to_owned() };
+        if let Err(e) = validate_endpoint(vendor, &endpoint) { self.status = e; return; }
+        if self.active_chat().is_some_and(|c| c.messages.len() >= 100 && c.provider == vendor) {
+            self.status = "Conversation limit reached (100 messages). Start a new chat.".into();
+            return;
+        }
+        // A provider change is a new conversation. Never silently send a previous
+        // provider's chat history to a different vendor.
+        if self.active_chat().is_some_and(|c| {
+            let has_history = !c.messages.is_empty();
+            let provider_changed = c.provider != vendor;
+            let endpoint_changed = vendor == Vendor::Custom && c.endpoint.as_deref() != Some(endpoint.as_str());
+            crate::gentaro::split_conversation(has_history, provider_changed, endpoint_changed)
+                .unwrap_or(has_history && (provider_changed || endpoint_changed))
+        }) {
+            self.create_chat();
+            self.status = "Destination changed: started a separate conversation to protect history.".into();
+        }
+        if self.active_chat().is_none() { self.create_chat(); }
+        let prompt = self.prompt.trim().to_owned();
+        let instruction = self.data.system_instructions.clone();
+        let chat = self.active_chat_mut().expect("chat created");
+        chat.provider = vendor;
+        chat.model = model.clone();
+        chat.endpoint = if vendor == Vendor::Custom { Some(endpoint.clone()) } else { None };
+        if chat.messages.is_empty() { chat.title = prompt.chars().take(45).collect(); }
+        chat.messages.push(Message { role: "user".into(), content: prompt });
+        let messages = chat.messages.clone();
+        let id = chat.id;
+        self.pending = Some(id);
+        self.status = "Sending only this conversation to the selected AI provider...".into();
+        self.prompt.clear();
+        self.save();
+        let sender = self.tx.clone();
+        thread::spawn(move || {
+            let result = request_chat(vendor, &endpoint, &model, &key, &instruction, &messages);
+            let _ = sender.send(Reply { id, text: result });
+        });
+    }
+    fn attach_text_file(&mut self) {
+        let Some(path) = rfd::FileDialog::new().set_title("Attach text file to the draft (not sent automatically)").pick_file() else {
+            return;
+        };
+        match std::fs::metadata(&path) {
+            Ok(metadata) if metadata.len() <= 24 * 1024 => {
+                match super::document::load(&path) {
+                    Ok(decoded) => {
+                        let label = path.file_name().unwrap_or_default().to_string_lossy();
+                        let snippet = format!("\n\nAttached text file: {label}\n```text\n{}\n```\n", decoded.text);
+                        if self.prompt.len() + snippet.len() > MAX_MESSAGE_BYTES {
+                            self.status = "Attachment would exceed 64 KiB prompt limit".into();
+                        } else {
+                            self.prompt.push_str(&snippet);
+                            self.status = "File inserted into draft. Review before pressing Send.".into();
+                        }
+                    }
+                    Err(e) => self.status = format!("Could not read attachment: {e}"),
+                }
+            }
+            Ok(_) => self.status = "Text attachments are limited to 24 KiB".into(),
+            Err(e) => self.status = format!("Could not inspect selected file: {e}"),
+        }
+    }
+    fn export_conversation(&mut self) {
+        let Some(chat) = self.active_chat() else {
+            self.status = "No conversation selected".into(); return;
+        };
+        let mut markdown = format!("# {}\n\nProvider: {}\nModel: {}\n\n",
+            chat.title, chat.provider.label(), chat.model);
+        for msg in &chat.messages {
+            markdown.push_str(&format!("## {}\n\n{}\n\n", msg.role, msg.content));
+        }
+        let Some(path) = rfd::FileDialog::new().set_title("Export AI chat as Markdown")
+            .set_file_name("toneedit-chat.md").save_file() else { return; };
+        self.status = match std::fs::write(path, markdown) {
+            Ok(()) => "Conversation exported".into(),
+            Err(e) => format!("Could not export chat: {e}"),
+        };
+    }
+    pub fn poll(&mut self) {
+        while let Ok(reply) = self.rx.try_recv() {
+            if self.pending != Some(reply.id) { continue; }
+            self.pending = None;
+            match reply.text {
+                Ok(content) => {
+                    if let Some(c) = self.data.conversations.iter_mut().find(|c| c.id == reply.id) {
+                        c.messages.push(Message { role: "assistant".into(), content });
+                    }
+                    self.status = "Answer received".into();
+                    self.save();
+                }
+                Err(e) => self.status = e,
+            }
+        }
+        while let Ok(response) = self.google_rx.try_recv() {
+            match response {
+                Ok(email) => self.google_status = format!("Connected to Google: {email}"),
+                Err(err) => self.google_status = format!("Google sign-in failed: {err}"),
+            }
+        }
+    }
