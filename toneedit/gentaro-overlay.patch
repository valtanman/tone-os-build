+fn main() -> eframe::Result<()> {
+    // This runs without opening a desktop window. Windows release automation
+    // uses it to exercise the real compiled executable and core disk I/O.
+    if std::env::args().any(|arg| arg == "--self-test") {
+        match smoke_test() {
+            Ok(()) => return Ok(()),
+            Err(error) => { eprintln!("ToneEdit self-test failed: {error}"); std::process::exit(1); }
+        }
+    }
+    let display_name = gentaro::product_name().unwrap_or_else(|_| "ToneEdit Studio".to_owned());
+    let options = eframe::NativeOptions {
+        renderer: eframe::Renderer::Wgpu,
+        viewport: egui::ViewportBuilder::default()
+            .with_title(format!("{display_name} 1.2.1"))
+            .with_inner_size([1400.0, 870.0])
+            .with_min_inner_size([800.0, 520.0]),
+        ..Default::default()
+    };
+    eframe::run_native("ToneEdit Studio", options, Box::new(|cc| {
+        setup_fonts(&cc.egui_ctx);
+        Ok(Box::new(EditorApp::new(&cc.egui_ctx)))
+    }))
+}
